# =============================================================================
# Trip Mate — backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- App -------------------------------------------------------------------
ENV=development                       # development | staging | production
PROJECT_NAME=Trip Mate
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# --- Security --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_dev_only_secret_key_do_not_use_in_production
JWT_ALGORITHM=HS256                   # HS256 (dev) | RS256 (prod, set keys below)
ACCESS_TOKEN_EXPIRE_MINUTES=15        # short-lived, held in memory on the client
REFRESH_TOKEN_EXPIRE_DAYS=7           # HttpOnly cookie, path-scoped to /api/v1/auth

# RS256 private/public keys (PEM, "\n" escaped) — required when JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cookie hardening
# Empty = host-only cookie (recommended; not sent to sibling subdomains).
# Set to e.g. ".example.com" only if the cookie must span subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=false                   # MUST be true in production (HTTPS/WSS)
COOKIE_SAMESITE=strict

# Argon2 runs in a worker thread so it cannot block the event loop.
# Each concurrent hash reserves ~64 MiB, so this is a MEMORY cap: keep it well
# below anyio's default of 40 (which could peak near 2.5 GB).
PASSWORD_HASH_MAX_CONCURRENCY=8

# CORS — comma separated, exact origins only. NEVER use "*".
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (ASYNC driver required) --------------------------------------
# Production : postgresql+asyncpg://tripmate:tripmate@localhost:5432/tripmate
# Local dev  : sqlite+aiosqlite:///./tripmate.db   (no server needed)
#
# Alembic derives its *sync* URL from this value automatically
# (asyncpg -> psycopg, aiosqlite -> sqlite), so keep the async driver here.
DATABASE_URL=postgresql+asyncpg://tripmate:tripmate@localhost:5432/tripmate
DB_ECHO=false                         # true logs every SQL statement (noisy)

# --- Rate limiting / cache / OTP -------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
OTP_TTL_SECONDS=300                   # SMS verification code lifetime (seconds)
OTP_DEV_ECHO=true                     # development ONLY: returns dev_code in the API response

# Redis holds OTP codes and revoked JWT ids. If it is unreachable the app still
# runs, but falls back to a PER-PROCESS store — so with more than one replica,
# OTP verification and token revocation will be inconsistent. Redis is required
# in production.

# --- SMS delivery (OTP) ----------------------------------------------------
# console : log the code. Development only — no SMS is actually delivered.
# webhook : POST {phone_number, code, sender_id, ttl_seconds} to SMS_WEBHOOK_URL.
#           Point this at a thin adapter that speaks your gateway's protocol.
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=                    # sent as `Authorization: Bearer <token>`
SMS_SENDER_ID=TripMate
SMS_TIMEOUT_SECONDS=10

# --- Object storage (S3 / Cloudflare R2) -----------------------------------
STORAGE_BACKEND=local                 # local | s3
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=tripmate-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
PRESIGN_EXPIRE_SECONDS=300
MAX_UPLOAD_BYTES=5242880              # 5 MB

# --- Local upload dir (STORAGE_BACKEND=local) ------------------------------
LOCAL_UPLOAD_DIR=./var/uploads

# --- Content moderation ----------------------------------------------------
# Applied to every user-generated text surface: trip title/description, profile
# nickname/bio, travel-history summary, review comment, chat messages (REST and
# WebSocket). BLOCK rejects the write with 422; FLAG allows it and only bumps a
# counter. The local rules are deliberately high precision — on a travel app a
# false positive is a real user who cannot publish.
CONTENT_FILTER_ENABLED=true
# local   : local rules only. No network, no third-party data processor.
# webhook : local rules, then POST {text, field} to CONTENT_WEBHOOK_URL.
#           Point this at a thin adapter that speaks your vendor's protocol.
CONTENT_FILTER_PROVIDER=local
CONTENT_WEBHOOK_URL=
CONTENT_WEBHOOK_TOKEN=                # sent as `Authorization: Bearer <token>`
CONTENT_WEBHOOK_TIMEOUT_SECONDS=5
# Fail open: a moderation outage must not become a total write outage. Turning
# this off makes the provider a hard dependency of every write — the same
# availability trade-off as RATE_LIMIT_ENABLED, and rarely the one you want.
CONTENT_FILTER_FAIL_OPEN=true

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=auto                       # auto | json | text (auto = json in production)
# Unauthenticated by design (scrapers carry no JWT), so it is OFF by default.
# Enable only behind an internal listener or an allowlist.
METRICS_ENABLED=false
# Trust X-Forwarded-For / X-Real-IP when recording an audit entry's IP address.
# Enable ONLY behind a proxy that overwrites those headers — otherwise a client
# can forge its own source address in the audit trail.
TRUST_PROXY_HEADERS=false
